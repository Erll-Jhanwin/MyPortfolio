# Application
APP_URL=http://localhost:3000
NODE_ENV=development
DATA_PROVIDER=sqlite
SQLITE_PATH=./data/portfolio.sqlite

# Staging / production: Supabase PostgreSQL connection string. Server only.
DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres?sslmode=require
# Optional server-only path to the Supabase CA certificate for hostname verification.
DATABASE_CA_CERT_PATH=
INDEX_PUBLIC_SITE=false
LAUNCH_CONTENT_APPROVED=false
RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret

# Inquiry notification destination; configure only on the server.
INQUIRY_TO_EMAIL=owner@example.com
INQUIRY_FROM_EMAIL=portfolio@example.com

# SMTP. For local development, run Mailpit and use its SMTP port.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Protect the scheduled notification endpoint with a long random value.
WORKER_SECRET=replace-with-a-long-random-secret

# Admin access: generate these locally with `npm run admin:hash-password`.
# Use an independent random username, password hash, and session secret per environment.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional display metadata; keep truthful and owner-confirmed before launch.
PUBLIC_LOCATION=Asia/Singapore
